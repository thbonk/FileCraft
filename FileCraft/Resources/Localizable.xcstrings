    "The helper is missing from FileCraft. Please reinstall FileCraft." : {
      "comment" : "Helper approval sheet when the app bundle lacks the helper.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Hilfsprogramm fehlt in FileCraft. Bitte installieren Sie FileCraft neu."
          }
        }
      }
    },
    "The helper is missing from the FileCraft application. Reinstall FileCraft." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dem Programm FileCraft fehlt das Hilfsprogramm. Installieren Sie FileCraft erneut."
          }
        }
      }
    },
    "The helper no longer knows this operation. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Hilfsprogramm kennt diesen Vorgang nicht mehr. Versuchen Sie es erneut."
          }
        }
      }
    },
    "The helper performs file operations that need administrator rights. macOS asks you to allow it in System Settings once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Hilfsprogramm führt Dateivorgänge aus, die Administratorrechte benötigen. macOS bittet Sie einmalig, es in den Systemeinstellungen zu erlauben."
          }
        }
      }
    },
    "The item is too large for the format of the destination volume." : {
      "comment" : "Error reason, for example for a file over 4 GB on a FAT32 volume.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Objekt ist zu groß für das Format des Zielvolumes."
          }
        }
      }
    },
    "The item may have been deleted, or it is on a volume that is not connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Objekt wurde möglicherweise gelöscht oder befindet sich auf einem Volume, das nicht verbunden ist."
          }
        }
      }
    },
    "The items can’t be moved there." : {
      "comment" : "Alert title when a drop is refused.",
