            "value" : "FileCraft"
          }
        }
      }
    },
    "FileCraft browses, organizes and manages your files with tabs, two panes, a shelf, batch renaming and more." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileCraft durchsucht, ordnet und verwaltet Ihre Dateien mit Tabs, Doppelansicht, Sammelbereich, Mehrfach-Umbenennen und mehr."
          }
        }
      }
    },
    "FileCraft can take Finder's place when other applications show files, for example with “Show in Finder”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileCraft kann den Finder ersetzen, wenn andere Programme Dateien zeigen, zum Beispiel mit »Im Finder zeigen«."
          }
        }
      }
    },
    "FileCraft can’t expand archives of this kind." : {
      "comment" : "Error reason for an unknown archive type.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileCraft kann Archive dieser Art nicht entpacken."
          }
        }
      }
    },
    "FileCraft can’t read the Trash." : {
      "comment" : "Alert when the Trash needs Full Disk Access.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileCraft kann den Papierkorb nicht lesen."
          }
        }
      }
    },
    "FileCraft is not authorized to make this change." : {
      "comment" : "Privileged helper refused a request without a valid authorization.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileCraft ist nicht berechtigt, diese Änderung vorzunehmen."
          }
        }
      }
    },
    "FileCraft needs Full Disk Access to show this folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileCraft benötigt den Festplattenvollzugriff, um diesen Ordner anzuzeigen."
          }
        }
      }
    },
    "FileCraft wants to change protected files." : {
      "comment" : "Prompt of the system authentication dialog.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FileCraft möchte geschützte Dateien ändern."
          }
        }
      }
    },
    "FileCraft works without it too; protected folders then show a hint instead of their contents." : {
      "localizations" : {
