{
  "sourceLanguage" : "en",
  "strings" : {
    "“%@” can't be ejected because it is in use." : {
      "comment" : "Alert title; %@ is the name of the volume.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« kann nicht ausgeworfen werden, weil es verwendet wird."
          }
        }
      }
    },
    "“%@” can’t be moved to the Trash." : {
      "comment" : "Alert title for an item in a protected location or on a read-only volume.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« kann nicht in den Papierkorb gelegt werden."
          }
        }
      }
    },
    "“%@” can’t be moved to the Trash. Do you want to delete it immediately?" : {
      "comment" : "Alert when an item cannot be moved to the Trash.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« kann nicht in den Papierkorb gelegt werden. Möchten Sie das Objekt sofort löschen?"
          }
        }
      }
    },
    "“%@” could not be ejected." : {
      "comment" : "Alert title; %@ is the name of the volume.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« konnte nicht ausgeworfen werden."
          }
        }
      }
    },
    "“%@” could not be moved to the Trash." : {
      "comment" : "Alert after Delete Alias failed; %@ is the name of the alias.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« konnte nicht in den Papierkorb gelegt werden."
          }
        }
      }
    },
    "“%@” could not be renamed. No items were renamed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« konnte nicht umbenannt werden. Es wurden keine Objekte umbenannt."
          }
        }
      }
    },
    "“%@” couldn’t be compressed." : {
      "comment" : "Error dialog title for Compress.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« konnte nicht komprimiert werden."
          }
        }
      }
    },
    "“%@” couldn’t be copied." : {
      "comment" : "Error dialog title; the argument is the item name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« konnte nicht kopiert werden."
          }
        }
      }
    },
    "“%@” couldn’t be deleted." : {
      "comment" : "Error dialog title for a deletion.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« konnte nicht gelöscht werden."
          }
        }
      }
    },
    "“%@” couldn’t be expanded." : {
      "comment" : "Error dialog title for Expand.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« konnte nicht entpackt werden."
          }
        }
      }
    },
    "“%@” couldn’t be moved." : {
      "comment" : "Error dialog title; the argument is the item name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« konnte nicht bewegt werden."
          }
        }
      }
    },
    "“%@” in %@" : {
      "comment" : "A recent search: search text and scope",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« in %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” in %2$@"
          }
        }
      }
    },
    "“%@” is not available." : {
      "comment" : "Alert title for a sidebar favorite whose item cannot be found; %@ is its name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%@« ist nicht verfügbar."
          }
        }
      }
    },
    "“Show in Finder” in other applications shows files in FileCraft. Applications that are already running must be restarted first. Folders that other applications open, as with “open” in Terminal, still open in Finder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»Im Finder zeigen« in anderen Programmen zeigt Dateien in FileCraft. Bereits geöffnete Programme müssen dafür neu gestartet werden. Ordner, die andere Programme öffnen, etwa mit »open« im Terminal, öffnen sich weiterhin im Finder."
          }
        }
      }
    },
    "%@ (default)" : {
      "comment" : "Open With menu: %@ is the name of the default application of the selected items.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (Standard)"
          }
        }
      }
    },
    "%@ alias" : {
      "comment" : "Name of a new alias; %@ is the full name of the original item.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Alias"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ alias"
          }
        }
      }
    },
