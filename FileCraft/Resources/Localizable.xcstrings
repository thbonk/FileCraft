    },
    "This applies to all documents of the kind “%@”." : {
      "comment" : "%@ is the kind of the document, for example \"Markdown document\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das gilt für alle Dokumente der Art »%@«."
