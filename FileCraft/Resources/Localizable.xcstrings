      }
    },
    "A name can’t be empty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Name darf nicht leer sein."
          }
        }
      }
    },
    "A name can’t contain “:” or “/”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
